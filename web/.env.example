# Copy this file to .env (gitignored) and fill in your real key.
#
# Paystack public key -- from https://dashboard.paystack.com/#/settings/developers.
# Safe to expose client-side (that's what it's for), but keep it out of git
# anyway so switching between test/live keys per-environment doesn't need a
# code change. Leave unset to keep the "pay the organizer directly" fallback
# checkout flow instead of the Paystack popup.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
