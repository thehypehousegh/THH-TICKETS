rules_version = '2';

// Data model & trust model (see README.md for the full picture):
//  - organizers/{uid}        -- one profile per signed-in host account.
//  - events/{eventId}        -- eventId is a short, random, human-typeable
//                               code (see host/src/data/joinCode.ts). It is
//                               NOT a secret in the cryptographic sense --
//                               it IS the public "join code" handed to door
//                               verifiers and embedded in the public
//                               purchase link. Knowing it grants read access
//                               and limited check-in write access by design.
//  - events/{eventId}/batches/{batchId}  -- one per reservation/purchase.
//  - events/{eventId}/codes/{codeId}     -- one per issued ticket.
//  - events/{eventId}/discounts/{id}     -- discount codes for that event.
//
// Only the organizer who created an event (hostUid == auth.uid) may create,
// edit, or delete it, its batches, codes, or discounts. Anyone holding the
// event's join code -- the verifier app requires no login at all -- may read
// the event and flip a code's usedAt/usedBy fields to check someone in or
// undo a mistaken check-in, and nothing else: they can never create/delete a
// code or batch, or edit a code's actual ticket data.
//
// Super-admin: an organizer document's isAdmin field, which the app never
// sets itself -- only ever toggled by hand in the Firebase console -- grants
// that one account read access across every organizer and event on the
// platform (see host/src/screens/AdminScreen.tsx and web/src/pages/Admin.tsx),
// AND the same create/update/delete access over any event, batch, code, or
// discount that the event's own organizer has -- so the admin can open and
// fix any event directly (see web/src/pages/EventManage.tsx), not just view
// it. It still cannot touch another organizer's profile fields besides
// isAdmin (never settable by any client) or read another organizer's
// purchaseRequests unless they also own the related event.
//
// supportThreads/{id} + supportThreads/{id}/messages/{id}: a lightweight
// help-desk channel. Either the organizer it belongs to, or the admin, may
// start one (organizerUid is fixed at creation and never changes), post
// messages into it, and read it; no one else can. eventId is optional (null
// = a general question, not tied to one event) purely for display context.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/organizers/$(request.auth.uid))
        && get(/databases/$(database)/documents/organizers/$(request.auth.uid)).data.isAdmin == true;
    }

    match /organizers/{uid} {
      allow get: if true; // public organizer name/logo shown on purchase pages
      allow list: if isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    match /events/{eventId} {
      allow get: if true;
      // list (a collection query, unlike get) is only granted for queries
      // Firestore can statically prove are constrained to published events
      // -- i.e. a `where('status', '==', 'published')` filter, exactly what
      // THH Events' public browse page and the Upcoming Events feed on the
      // main site both use (see web/src/data/queries.ts's
      // watchPublishedEvents). A bare, unfiltered list still requires being
      // the event's own organizer or the admin.
      allow list: if isAdmin()
        || (request.auth != null && request.auth.uid == resource.data.hostUid)
        || resource.data.status == 'published';
      allow create: if request.auth != null && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if request.auth != null
        && (resource.data.hostUid == request.auth.uid || isAdmin());

      match /batches/{batchId} {
        allow get, list: if true;
        allow create, update, delete: if request.auth != null && (
          get(/databases/$(database)/documents/events/$(eventId)).data.hostUid == request.auth.uid
          || isAdmin()
        );
      }

      match /codes/{codeId} {
        allow get, list: if true;
        allow create, delete: if request.auth != null && (
          get(/databases/$(database)/documents/events/$(eventId)).data.hostUid == request.auth.uid
          || isAdmin()
        );
        allow update: if request.auth != null && (
          get(/databases/$(database)/documents/events/$(eventId)).data.hostUid == request.auth.uid
          || isAdmin()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedAt', 'usedBy'])
        );
      }

      match /discounts/{discountId} {
        allow get, list: if true; // the future checkout page validates a code without logging in
        allow create, update, delete: if request.auth != null && (
          get(/databases/$(database)/documents/events/$(eventId)).data.hostUid == request.auth.uid
          || isAdmin()
        );
      }
    }

    // Submitted by the web app's public checkout page (no login required --
    // anyone with an event's join code can buy a ticket to it). Each request
    // sits as 'pending' until either the organizer manually confirms payment
    // (Paystack isn't wired up yet -- see README.md's "Online ticket sales"
    // section) or, once it is, a Cloud Function does the same automatically.
    // Either way, only the event's own organizer may flip its status --
    // never the unauthenticated buyer who created it, and never any other
    // field.
    match /purchaseRequests/{requestId} {
      allow get: if true;
      allow list: if request.auth != null && (isAdmin() || resource.data.hostUid == request.auth.uid);
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.hostUid ==
          get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.hostUid;
      allow update: if request.auth != null && resource.data.hostUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    // Help-desk threads: an organizer reaching the admin about a specific
    // event, or a general question. See the file-level comment above.
    match /supportThreads/{threadId} {
      function isParticipant() {
        return request.auth != null
          && (resource.data.organizerUid == request.auth.uid || isAdmin());
      }

      allow get, list: if isParticipant();
      allow create: if request.auth != null
        && (request.resource.data.organizerUid == request.auth.uid || isAdmin());
      // Only status/lastMessage* bookkeeping fields ever change after
      // creation -- organizerUid, eventId, etc. are fixed at creation time.
      allow update: if isParticipant()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'lastMessageAt', 'lastMessagePreview']);
      allow delete: if false;

      match /messages/{messageId} {
        function threadParticipant() {
          return request.auth != null && (
            get(/databases/$(database)/documents/supportThreads/$(threadId)).data.organizerUid == request.auth.uid
            || isAdmin()
          );
        }

        allow get, list: if threadParticipant();
        allow create: if threadParticipant() && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
