{
  "expo": {
    "name": "THH Tickets Host",
    "slug": "thh-tickets-host",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#161826",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#161826",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "package": "com.thehypehousegh.thhtickets.host"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow THH Tickets Host to use the camera to scan ticket QR codes at check-in."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow THH Tickets Host to save generated ticket QR codes to your photos.",
          "savePhotosPermission": "Allow THH Tickets Host to save generated ticket QR codes to your photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow THH Tickets Host to pick an event flyer or logo image."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow THH Tickets Host to use your current location as a venue map pin."
        }
      ]
    ]
  }
}
